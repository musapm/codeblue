# UniAgent AI — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# Full reference: docs/environment-variables.md

# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle at BUILD time — never put secrets here)
# ---------------------------------------------------------------------------

# Absolute URL of this deployment. Used for auth email links and metadata.
# Must be set at build time in staging/production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Phase 2). Leave empty to run without authentication.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon key. Safe for browsers; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform branding (optional; defaults shown)
# NEXT_PUBLIC_PLATFORM_NAME="UniAgent AI"
# NEXT_PUBLIC_PLATFORM_SHORT_NAME="UniAgent"
# NEXT_PUBLIC_PLATFORM_ASSISTANT_NAME="UniAgent AI Assistant"
# NEXT_PUBLIC_PLATFORM_SUPPORT_EMAIL=support@example.com
# NEXT_PUBLIC_PLATFORM_SALES_EMAIL=sales@example.com
# NEXT_PUBLIC_PLATFORM_PRIMARY_COLOR=#1b4f8f
# NEXT_PUBLIC_PLATFORM_SECONDARY_COLOR=#0f2a4a
# NEXT_PUBLIC_PLATFORM_ACCENT_COLOR=#b7862c

# ---------------------------------------------------------------------------
# Server-only (read at runtime; never exposed to the browser)
# ---------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Show the workspace shell with a fictional identity. Honoured ONLY when Supabase is
# not configured (see ADR-012). Never set this in production.
UNIAGENT_UI_PREVIEW=false

# Supabase secret (service-role) key — background jobs only (Phase 4+). Bypasses RLS.
# SUPABASE_SECRET_KEY=

# AI providers (Phase 5)
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------
# Disposable PostgreSQL for `npm run test:db` (creates/drops its own temporary database)
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
